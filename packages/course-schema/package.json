{
  "name": "@coursmith/course-schema",
  "version": "0.1.0",
  "description": "Coursmith course format: Zod schema, deterministic validator, JSON Schema export and quiz grading.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./course.schema.json": "./dist/course.schema.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsx scripts/export-json-schema.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "vega-lite": "^6.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.23.15",
    "vitest": "^5.0.5"
  }
}
