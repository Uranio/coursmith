# Supabase (Project Settings → API keys)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only: bypasses RLS. Never expose to the browser.
SUPABASE_SECRET_KEY=

# Public URL of the portal (used in device-flow links and certificates)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Moderation agent via OpenRouter (https://openrouter.ai/models)
OPENROUTER_API_KEY=
# Model slugs from the OpenRouter catalog. The safety model must accept images.
MODERATION_MODEL_SAFETY=
MODERATION_MODEL_REVIEW=
# low | medium | high — for reasoning models; low keeps reviews fast and cheap
MODERATION_REASONING_EFFORT=low

# Shared secret Vercel Cron sends as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=

# Oldest CLI version the API accepts
MIN_CLI_VERSION=0.1.0
